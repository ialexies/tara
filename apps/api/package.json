{
  "name": "@tara/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file=../../.env --import=@swc-node/register/esm-register --watch src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-fastify": "^10.4.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/node": "^10.54.0",
    "@tara/auth": "workspace:^",
    "@tara/db": "workspace:*",
    "@tara/schemas": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "firebase-admin": "^13.10.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "zod": "^3.23.8"
