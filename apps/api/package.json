  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.5",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.15.40",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^4.1.7",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.3"
