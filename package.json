{
  "name": "tara",
  "version": "0.0.0",
  "private": true,
  "description": "Tara — a booking marketplace for Philippine hostels. Launching in Zambales.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down",
    "db:logs": "docker compose -f infra/docker-compose.dev.yml --env-file .env logs -f",
    "db:reset": "docker compose -f infra/docker-compose.dev.yml --env-file .env down -v && docker compose -f infra/docker-compose.dev.yml --env-file .env up -d",
    "db:build": "docker compose -f infra/docker-compose.dev.yml --env-file .env build",
    "db:psql": "docker exec -it tara-postgres psql -U tara -d tara_dev",
    "db:generate": "pnpm --filter @tara/db db:generate",
    "db:migrate": "DATABASE_URL=postgres://tara:tara@localhost:5433/tara_dev pnpm --filter @tara/db db:migrate",
    "db:studio": "DATABASE_URL=postgres://tara:tara@localhost:5433/tara_dev pnpm --filter @tara/db db:studio",
    "db:seed": "docker cp infra/scripts/seed.sql tara-postgres:/tmp/seed.sql && docker exec tara-postgres psql -U tara -d tara_dev -f /tmp/seed.sql",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
