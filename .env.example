# Copy to .env and fill in real values. Never commit .env.

# ─── Runtime ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── App URLs ───────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Browser-side API URL baked into the Next.js build (used by client components + CSP).
# Set as a Docker build arg when building the web image.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://tara:tara@localhost:5433/tara_dev

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-base64-32

# ─── Firebase (Admin SDK) ───────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase (Client SDK — public, bundled into browser) ───────────
# These go in apps/web/.env.local with NEXT_PUBLIC_ prefix
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Stripe (test mode keys) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Tara <noreply@tara-stays.com>"

# ─── Storage (Cloudflare R2) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tara-dev
R2_PUBLIC_URL=

# ─── Mock data toggles (see docs/business/mock-data.md) ─────────────
SEED_MOCK_PROPERTIES=true
SEED_MOCK_REVIEWS=true
SEED_MOCK_ACTIVITY=true

# ─── Observability ──────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Log level for apps/api (Pino). Valid: fatal | error | warn | info | debug | trace
# Default: 'debug' in dev, 'info' in production when unset.
LOG_LEVEL=debug

# ─── Feature flags ──────────────────────────────────────────────────
FEATURE_OTA_SYNC=false
FEATURE_TOURS=true
FEATURE_AI_DESCRIPTIONS=false
