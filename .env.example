# Copy to .env and fill in real values. Never commit .env.

# ─── Runtime ────────────────────────────────────────────────────────
NODE_ENV=development

# ─── App URLs ───────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://tara:tara@localhost:5432/tara_dev

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32

# ─── Stripe (test mode keys) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Tara <noreply@tarastays.com>"

# ─── Storage (Cloudflare R2) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tara-dev
R2_PUBLIC_URL=

# ─── Mock data toggles (see docs/business/mock-data.md) ─────────────
SEED_MOCK_PROPERTIES=true
SEED_MOCK_REVIEWS=true
SEED_MOCK_ACTIVITY=true

# ─── Observability ──────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# ─── Feature flags ──────────────────────────────────────────────────
FEATURE_OTA_SYNC=false
FEATURE_TOURS=true
FEATURE_AI_DESCRIPTIONS=false
